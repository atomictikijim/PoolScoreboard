<Window x:Class="PoolScoreboard.Controller.RecordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PoolScoreboard Player Records"
        Height="520"
        Width="820"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="RecordsHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="RecordsCellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="RecordsRowStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="PLAYER RECORDS" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="What every name in the recorded matches has played and won, and how any two of them stand against each other."
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- Every name that has played, winners first: the chips in the History window, with the matches behind them. -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="NAME" Style="{StaticResource RecordsHeaderStyle}" />
                    <TextBlock Grid.Column="1" Text="PLAYED" Style="{StaticResource RecordsHeaderStyle}" />
                    <TextBlock Grid.Column="2" Text="WON" Style="{StaticResource RecordsHeaderStyle}" />
                    <TextBlock Grid.Column="3" Text="LOST" Style="{StaticResource RecordsHeaderStyle}" />
                    <TextBlock Grid.Column="4" Text="WIN %" Style="{StaticResource RecordsHeaderStyle}" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="RecordsList" ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RecordsRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource RecordsCellStyle}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Played}" Style="{StaticResource RecordsCellStyle}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Won}" Style="{StaticResource RecordsCellStyle}"
                                                   Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Lost}" Style="{StaticResource RecordsCellStyle}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Rate}" Style="{StaticResource RecordsCellStyle}"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="NoRecordsText" Grid.Row="2" Margin="0,12,0,0"
                           Text="No matches recorded yet — finish a match and its players appear here."
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                           Visibility="{Binding HasNoRecords, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>

            <!-- Two names picked, and the record between them. -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="HEAD TO HEAD" Style="{StaticResource LabelTextBlockStyle}" />
                <ComboBox x:Name="FirstPlayerPicker" ItemsSource="{Binding PlayerNames}"
                          SelectedItem="{Binding FirstPlayer}" Margin="0,4,0,0"
                          Style="{StaticResource StandardComboBoxStyle}"
                          ToolTip="First player." />
                <TextBlock Text="against" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                           Margin="0,8,0,8" />
                <ComboBox x:Name="SecondPlayerPicker" ItemsSource="{Binding PlayerNames}"
                          SelectedItem="{Binding SecondPlayer}"
                          Style="{StaticResource StandardComboBoxStyle}"
                          ToolTip="Second player." />

                <Border Background="{StaticResource InputBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="14,12" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock x:Name="HeadToHeadTitleText" Text="{Binding HeadToHeadTitle}"
                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="HeadToHeadDetailText" Text="{Binding HeadToHeadDetail}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Button Grid.Row="4" Content="Close" Style="{StaticResource InactiveButtonStyle}" Click="Close_Click"
                HorizontalAlignment="Right" Padding="20,8" />
    </Grid>
</Window>
