<Window x:Class="PoolScoreboard.Controller.FlagPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:flags="clr-namespace:PoolScoreboard.Controller.Assets.Flags"
        Title="Choose a Flag"
        Height="640"
        Width="820"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <DataTemplate x:Key="FlagTileTemplate">
            <Button Click="FlagTile_Click" Cursor="Hand" Margin="4" Padding="6"
                    Background="Transparent" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Width="88">
                    <Border Width="64" Height="42" HorizontalAlignment="Center" Background="#0a0a0a" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                        <svgc:SvgViewbox Source="{Binding PackUri}" Stretch="Uniform" Margin="2" />
                    </Border>
                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="STATES" Style="{StaticResource LabelTextBlockStyle}" FontSize="14" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{x:Static flags:FlagCatalog.States}" ItemTemplate="{StaticResource FlagTileTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="COUNTRIES" Style="{StaticResource LabelTextBlockStyle}" FontSize="14" Margin="0,20,0,8" />
                <ItemsControl ItemsSource="{x:Static flags:FlagCatalog.Countries}" ItemTemplate="{StaticResource FlagTileTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Cancel" Style="{StaticResource InactiveButtonStyle}" Click="Cancel_Click"
                HorizontalAlignment="Right" Padding="16,8" />
    </Grid>
</Window>
