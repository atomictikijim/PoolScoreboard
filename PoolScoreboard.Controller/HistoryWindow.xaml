<Window x:Class="PoolScoreboard.Controller.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PoolScoreboard Match History"
        Height="560"
        Width="780"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="HistoryHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="HistoryCellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="HistoryRowStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="MATCH HISTORY" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Every match this app has recorded, newest first, and how many each name has won."
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Wins, as one chip per name that has won something. -->
        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="WINS" Style="{StaticResource LabelTextBlockStyle}" />
            <ItemsControl x:Name="StandingsList" ItemsSource="{Binding Standings}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource InputBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,8,8">
                            <TextBlock>
                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Bold"
                                     Foreground="{StaticResource TextPrimaryBrush}" />
                                <Run Text="{Binding Wins, Mode=OneWay}" FontWeight="Bold"
                                     Foreground="{StaticResource AccentBrush}" />
                                <Run Text="wins" Foreground="{StaticResource TextSecondaryBrush}" />
                            </TextBlock>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- The matches: fixed columns, newest first, read down the list. -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="WHEN" Style="{StaticResource HistoryHeaderStyle}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="HOME" Style="{StaticResource HistoryHeaderStyle}" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="SCORE" Style="{StaticResource HistoryHeaderStyle}" />
            <TextBlock Grid.Row="0" Grid.Column="3" Text="AWAY" Style="{StaticResource HistoryHeaderStyle}" />
            <TextBlock Grid.Row="0" Grid.Column="4" Text="WON BY" Style="{StaticResource HistoryHeaderStyle}" />

            <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="MatchesList" ItemsSource="{Binding Matches}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource HistoryRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding When}" Style="{StaticResource HistoryCellStyle}"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Home}" Style="{StaticResource HistoryCellStyle}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Score}" Style="{StaticResource HistoryCellStyle}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Away}" Style="{StaticResource HistoryCellStyle}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Winner}" Style="{StaticResource HistoryCellStyle}"
                                               Foreground="{StaticResource AccentBrush}" />
                                    <Button Grid.Column="5" Content="Delete" Tag="{Binding}" Click="DeleteMatch_Click"
                                            Style="{StaticResource InactiveButtonStyle}" Padding="10,4"
                                            VerticalAlignment="Center"
                                            ToolTip="Remove this match from the history." />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="NoMatchesText" Grid.Row="2" Margin="0,12,0,0"
                       Text="No matches recorded yet — finish a match and it appears here."
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                       Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>

        <Button Grid.Row="5" Content="Close" Style="{StaticResource InactiveButtonStyle}" Click="Close_Click"
                HorizontalAlignment="Right" Padding="20,8" />
    </Grid>
</Window>
