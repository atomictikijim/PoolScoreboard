<Window x:Class="PoolScoreboard.Controller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PoolScoreboard.Controller"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        Title="PoolScoreboard Controller"
        Height="700"
        Width="1200"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header with Game Type and Race-To Mode -->
            <Border Grid.Row="0" Padding="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Game Type -->
                    <TextBlock Grid.Column="0" Text="Game" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1" SelectedValue="{Binding SelectedGameType}" Style="{StaticResource StandardComboBoxStyle}">
                        <system:String>EightBall</system:String>
                        <system:String>NineBall</system:String>
                        <system:String>TenBall</system:String>
                    </ComboBox>

                    <!-- Race-To Mode -->
                    <TextBlock Grid.Column="2" Text="Race To" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Margin="20,0,8,0" />
                    <ComboBox Grid.Column="3" SelectedValue="{Binding SelectedRaceToMode}" Style="{StaticResource StandardComboBoxStyle}">
                        <system:String>Single</system:String>
                        <system:String>Split</system:String>
                    </ComboBox>

                    <!-- Current Shooter Toggle -->
                    <Button Grid.Column="5"
                            x:Name="CurrentShooterToggleButton"
                            Style="{StaticResource ActiveButtonStyle}"
                            Command="{Binding ToggleCurrentShooterCommand}"
                            Height="36" />
                </Grid>
            </Border>

            <!-- Main Content: Two Column Layout -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- HOME Player Panel -->
                <Border Grid.Column="0" Style="{StaticResource PlayerPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="HOME" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                        <!-- Team Name -->
                        <TextBlock Text="Team Name" Style="{StaticResource LabelTextBlockStyle}" />
                        <TextBox Text="{Binding HomePlayer.TeamName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource StandardTextBoxStyle}" />

                        <!-- Player Name -->
                        <TextBlock Text="Player Name" Style="{StaticResource LabelTextBlockStyle}" />
                        <TextBox Text="{Binding HomePlayer.PlayerName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource StandardTextBoxStyle}" />

                        <!-- Race To -->
                        <TextBlock Text="Race To" Style="{StaticResource LabelTextBlockStyle}" />
                        <TextBox Text="{Binding HomePlayer.RaceToTarget, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource StandardTextBoxStyle}"
                                 Width="70"
                                 HorizontalAlignment="Left" />

                        <!-- Ball Group (8-ball only) -->
                        <StackPanel Visibility="{Binding IsEightBall, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,4,0,0">
                            <TextBlock Text="Ball Group" Style="{StaticResource LabelTextBlockStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Solids" Style="{StaticResource InactiveButtonStyle}" Command="{Binding AssignHomeSolidsCommand}" />
                                <Button Grid.Column="2" Content="Stripes" Style="{StaticResource InactiveButtonStyle}" Command="{Binding AssignHomeStripesCommand}" />
                            </Grid>
                        </StackPanel>

                        <!-- Score -->
                        <TextBlock Text="SCORE" Style="{StaticResource LabelTextBlockStyle}" Margin="0,12,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="−" Style="{StaticResource CounterButtonStyle}" Command="{Binding HomePlayer.DecrementScoreCommand}" Margin="0,0,4,0" />
                            <TextBlock Grid.Column="1" Text="{Binding HomePlayer.Score}" Style="{StaticResource LargeValueTextBlockStyle}" />
                            <Button Grid.Column="2" Content="+" Style="{StaticResource CounterButtonStyle}" Command="{Binding HomePlayer.IncrementScoreCommand}" Margin="4,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- AWAY Player Panel -->
                <Border Grid.Column="2" Style="{StaticResource PlayerPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="AWAY" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                        <!-- Team Name -->
                        <TextBlock Text="Team Name" Style="{StaticResource LabelTextBlockStyle}" />
                        <TextBox Text="{Binding AwayPlayer.TeamName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource StandardTextBoxStyle}" />

                        <!-- Player Name -->
                        <TextBlock Text="Player Name" Style="{StaticResource LabelTextBlockStyle}" />
                        <TextBox Text="{Binding AwayPlayer.PlayerName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource StandardTextBoxStyle}" />

                        <!-- Race To (only editable in Split mode; mirrors Home in Single mode) -->
                        <TextBlock Text="Race To" Style="{StaticResource LabelTextBlockStyle}" />
                        <TextBox Text="{Binding AwayPlayer.RaceToTarget, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource StandardTextBoxStyle}"
                                 Width="70"
                                 HorizontalAlignment="Left"
                                 IsEnabled="{Binding IsSplitRaceTo}" />

                        <!-- Ball Group (8-ball only) -->
                        <StackPanel Visibility="{Binding IsEightBall, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,4,0,0">
                            <TextBlock Text="Ball Group" Style="{StaticResource LabelTextBlockStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Solids" Style="{StaticResource InactiveButtonStyle}" Command="{Binding AssignAwaySolidsCommand}" />
                                <Button Grid.Column="2" Content="Stripes" Style="{StaticResource InactiveButtonStyle}" Command="{Binding AssignAwayStripesCommand}" />
                            </Grid>
                        </StackPanel>

                        <!-- Score -->
                        <TextBlock Text="SCORE" Style="{StaticResource LabelTextBlockStyle}" Margin="0,12,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="−" Style="{StaticResource CounterButtonStyle}" Command="{Binding AwayPlayer.DecrementScoreCommand}" Margin="0,0,4,0" />
                            <TextBlock Grid.Column="1" Text="{Binding AwayPlayer.Score}" Style="{StaticResource LargeValueTextBlockStyle}" />
                            <Button Grid.Column="2" Content="+" Style="{StaticResource CounterButtonStyle}" Command="{Binding AwayPlayer.IncrementScoreCommand}" Margin="4,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
