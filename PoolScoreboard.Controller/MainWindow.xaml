<Window x:Class="PoolScoreboard.Controller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PoolScoreboard.Controller"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        xmlns:enums="clr-namespace:PoolScoreboard.Core.Enums;assembly=PoolScoreboard.Core"
        mc:Ignorable="d"
        Title="PoolScoreboard Controller"
        Height="780"
        Width="1200"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="BallItemTemplate">
            <Button Style="{StaticResource BallButtonStyle}"
                    Content="{Binding Number}"
                    Command="{Binding DataContext.TogglePocketedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" />
        </DataTemplate>

        <!-- The overlay's show/hide toggles, on both the setup screen and the live view: the operator
             sets the show up before the match (START MATCH carries the current visibility over) and
             flips elements mid-match. ContentControl supplies the window's GameViewModel as the
             DataContext, so both copies bind to the same three booleans and stay in step. -->
        <DataTemplate x:Key="OverlayVisibilityTogglesTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="OVERLAY" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="Score Bar" Command="{Binding ToggleScoreBarVisibleCommand}"
                        Style="{Binding ScoreBarVisible, Converter={StaticResource BoolToButtonStyleConverter}}" Padding="12,8" Margin="0,0,8,0" />
                <Button Content="Ball Tracker" Command="{Binding ToggleBallTrackerVisibleCommand}"
                        Style="{Binding BallTrackerVisible, Converter={StaticResource BoolToButtonStyleConverter}}" Padding="12,8" Margin="0,0,8,0" />
                <Button Content="Winner Banner" Command="{Binding ToggleWinnerBannerVisibleCommand}"
                        Style="{Binding WinnerBannerVisible, Converter={StaticResource BoolToButtonStyleConverter}}" Padding="12,8" Margin="0,0,8,0" />
                <Button Content="{Binding ShotClockDisplayButtonText}" Command="{Binding ToggleShotClockDisplayCommand}"
                        Style="{StaticResource InactiveButtonStyle}" Padding="12,8" Margin="0,0,8,0"
                        ToolTip="The running shot clock: the numbers, or a line that drains and turns red in its last five seconds. Press to swap." />
                <Button Content="{Binding StaleCueButtonText}" Command="{Binding ToggleStaleCueCommand}"
                        Style="{Binding StaleCueEnabled, Converter={StaticResource BoolToButtonStyleConverter}}" Padding="12,8"
                        ToolTip="Marks the scoreboard once its stream has been dead for a few seconds, so frozen numbers cannot pass for live ones. Press to turn on or off." />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Persistent top bar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="POOLSCOREBOARD" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />

                <!-- The port the overlay and the control API are served on. Editable so a program that already
                     holds the usual one is not the end of the overlay for the session: the host rebinds to the new
                     port as soon as the field loses focus, and the banner below names whatever is wrong with it. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="OVERLAY PORT" Style="{StaticResource LabelTextBlockStyle}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding OverlayPort, UpdateSourceTrigger=LostFocus}" Width="70"
                             AutomationProperties.AutomationId="OverlayPortBox"
                             Style="{StaticResource StandardTextBoxStyle}" Margin="0"
                             ToolTip="1024-65535. Change it when another program holds this port, then press Retry if the overlay is off." />
                </StackPanel>

                <!-- Only present when the overlay host is not serving — a failed start or a host that
                     stopped mid-session: the reason names the process on the overlay port when that is what took
                     the port, says to close another Controller's window when that is the way out, and Retry tries
                     again without a restart. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"
                            Visibility="{Binding OverlayIsOffline, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding OverlayStatus}" Foreground="{StaticResource WarningBrush}"
                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560" />
                    <Button Content="Retry" Style="{StaticResource InactiveButtonStyle}"
                            Command="{Binding RetryOverlayCommand}" Padding="14,6" Margin="12,0,0,0" />
                </StackPanel>

                <Button Grid.Column="3" Content="History" Style="{StaticResource InactiveButtonStyle}"
                        Command="{Binding ShowHistoryCommand}" Padding="16,6" Margin="0,0,8,0"
                        ToolTip="The recorded matches and each player's wins." />

                <Button Grid.Column="4" Content="Help" Style="{StaticResource InactiveButtonStyle}"
                        Command="{Binding ShowHelpCommand}" Padding="16,6" />
            </Grid>

            <Grid Grid.Row="1">
            <!-- ================= MATCH SETUP ================= -->
            <Grid Visibility="{Binding GameInitialized, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="MATCH SETUP" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />

                <!-- Setup presets: the look plus the four per-match choices that otherwise get retyped every night
                     (game type, Race-To mode and both clock lengths), and the venue's overlay port. Picking one applies
                     it to the screen; SAVE PRESET captures what is on screen under the name typed beside it. A line of
                     status text instead of a dialog: this is mid-setup, so nothing here should need dismissing. -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="SETUP PRESET" Style="{StaticResource LabelTextBlockStyle}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Grid.Column="1" Width="180" ItemsSource="{Binding PresetNames}"
                              SelectedItem="{Binding SelectedPreset}"
                              AutomationProperties.AutomationId="SetupPresetPicker"
                              ToolTip="Pick a saved setup to apply its look, game type, Race-To mode, clock lengths and port." />
                    <TextBox Grid.Column="2" Width="170" Margin="10,0,0,0"
                             Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="PresetNameBox"
                             Style="{StaticResource StandardTextBoxStyle}"
                             ToolTip="Name to save the setup on screen under. Saving an existing name replaces it." />
                    <Button Grid.Column="3" Content="SAVE PRESET" Style="{StaticResource InactiveButtonStyle}"
                            Command="{Binding SavePresetCommand}" Padding="14,6" Margin="10,0,0,0" />
                    <Button Grid.Column="4" Content="Delete" Style="{StaticResource InactiveButtonStyle}"
                            Command="{Binding DeletePresetCommand}" Padding="12,6" Margin="8,0,0,0"
                            ToolTip="Remove the picked preset." />
                    <TextBlock Grid.Column="5" Text="{Binding PresetStatus}" Margin="12,0,0,0"
                               VerticalAlignment="Center" Style="{StaticResource ValueTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>


                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="1.3*" />
                    </Grid.ColumnDefinitions>

                    <!-- Game config + color theme -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Game" Style="{StaticResource LabelTextBlockStyle}" />
                        <ComboBox SelectedValue="{Binding SelectedGameType}" Style="{StaticResource StandardComboBoxStyle}">
                            <x:Static Member="enums:GameType.EightBall" />
                            <x:Static Member="enums:GameType.NineBall" />
                            <x:Static Member="enums:GameType.TenBall" />
                        </ComboBox>

                        <TextBlock Text="Race-To Mode" Style="{StaticResource LabelTextBlockStyle}" Margin="0,12,0,4" />
                        <ComboBox SelectedValue="{Binding SelectedRaceToMode}" Style="{StaticResource StandardComboBoxStyle}">
                            <x:Static Member="enums:RaceToMode.Single" />
                            <x:Static Member="enums:RaceToMode.Split" />
                        </ComboBox>

                        <TextBlock Text="SHOT CLOCK" Style="{StaticResource LabelTextBlockStyle}" Margin="0,20,0,8" />

                        <!-- The two lengths the clock on the overlay uses. Carried into the match START MATCH
                             begins, like the game type and Race-To mode beside them, so they are changed here
                             between matches rather than mid-rack. -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Shot length (sec)" VerticalAlignment="Center" Style="{StaticResource ValueTextBlockStyle}" />
                            <TextBox Grid.Column="2" Text="{Binding ShotClockSeconds, UpdateSourceTrigger=LostFocus}"
                                     AutomationProperties.AutomationId="ShotClockSecondsBox"
                                     Style="{StaticResource StandardTextBoxStyle}" Margin="0"
                                     ToolTip="How long each shot gets, 5-300 seconds." />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Extension (sec)" VerticalAlignment="Center" Style="{StaticResource ValueTextBlockStyle}" />
                            <TextBox Grid.Column="2" Text="{Binding ShotClockExtensionSeconds, UpdateSourceTrigger=LostFocus}"
                                     AutomationProperties.AutomationId="ShotClockExtensionSecondsBox"
                                     Style="{StaticResource StandardTextBoxStyle}" Margin="0"
                                     ToolTip="Time a called extension adds. Each player gets one per rack." />
                        </Grid>

                        <TextBlock Text="COLOR THEME" Style="{StaticResource LabelTextBlockStyle}" Margin="0,20,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Home Background" VerticalAlignment="Center" Style="{StaticResource ValueTextBlockStyle}" />
                            <TextBox Grid.Column="2" Text="{Binding HomeBackgroundColor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBoxStyle}" Margin="0" />
                            <Button Grid.Column="4" Style="{StaticResource SwatchButtonStyle}"
                                    Background="{Binding HomeBackgroundColor, Converter={StaticResource HexColorToBrushConverter}}"
                                    Command="{Binding PickColorCommand}" CommandParameter="HomeBackground" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Away Background" VerticalAlignment="Center" Style="{StaticResource ValueTextBlockStyle}" />
                            <TextBox Grid.Column="2" Text="{Binding AwayBackgroundColor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBoxStyle}" Margin="0" />
                            <Button Grid.Column="4" Style="{StaticResource SwatchButtonStyle}"
                                    Background="{Binding AwayBackgroundColor, Converter={StaticResource HexColorToBrushConverter}}"
                                    Command="{Binding PickColorCommand}" CommandParameter="AwayBackground" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Home Accent" VerticalAlignment="Center" Style="{StaticResource ValueTextBlockStyle}" />
                            <TextBox Grid.Column="2" Text="{Binding HomeAccentColor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBoxStyle}" Margin="0" />
                            <Button Grid.Column="4" Style="{StaticResource SwatchButtonStyle}"
                                    Background="{Binding HomeAccentColor, Converter={StaticResource HexColorToBrushConverter}}"
                                    Command="{Binding PickColorCommand}" CommandParameter="HomeAccent" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Away Accent" VerticalAlignment="Center" Style="{StaticResource ValueTextBlockStyle}" />
                            <TextBox Grid.Column="2" Text="{Binding AwayAccentColor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBoxStyle}" Margin="0" />
                            <Button Grid.Column="4" Style="{StaticResource SwatchButtonStyle}"
                                    Background="{Binding AwayAccentColor, Converter={StaticResource HexColorToBrushConverter}}"
                                    Command="{Binding PickColorCommand}" CommandParameter="AwayAccent" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Home Text" VerticalAlignment="Center" Style="{StaticResource ValueTextBlockStyle}" />
                            <TextBox Grid.Column="2" Text="{Binding HomeTextColor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBoxStyle}" Margin="0" />
                            <Button Grid.Column="4" Style="{StaticResource SwatchButtonStyle}"
                                    Background="{Binding HomeTextColor, Converter={StaticResource HexColorToBrushConverter}}"
                                    Command="{Binding PickColorCommand}" CommandParameter="HomeText" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Away Text" VerticalAlignment="Center" Style="{StaticResource ValueTextBlockStyle}" />
                            <TextBox Grid.Column="2" Text="{Binding AwayTextColor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBoxStyle}" Margin="0" />
                            <Button Grid.Column="4" Style="{StaticResource SwatchButtonStyle}"
                                    Background="{Binding AwayTextColor, Converter={StaticResource HexColorToBrushConverter}}"
                                    Command="{Binding PickColorCommand}" CommandParameter="AwayText" />
                        </Grid>
                    </StackPanel>

                    <!-- Scoreboard style -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="SCOREBOARD STYLE" Style="{StaticResource LabelTextBlockStyle}" Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Roundness" VerticalAlignment="Center" Style="{StaticResource ValueTextBlockStyle}" />
                            <Slider Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding CornerRoundness}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding CornerRoundness}" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource ValueTextBlockStyle}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Scale" VerticalAlignment="Center" Style="{StaticResource ValueTextBlockStyle}" />
                            <Slider Grid.Column="2" Minimum="50" Maximum="200" Value="{Binding OverallScale}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding OverallScale, StringFormat={}{0}%}" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource ValueTextBlockStyle}" />
                        </Grid>

                        <CheckBox Content="Glossy Finish" IsChecked="{Binding GlossyFinish}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,12" />

                        <TextBlock Text="End-Cap Style" Style="{StaticResource LabelTextBlockStyle}" />
                        <ComboBox SelectedValue="{Binding SelectedEndCapStyle}" Style="{StaticResource StandardComboBoxStyle}" Margin="0,0,0,12">
                            <x:Static Member="enums:EndCapStyle.Dot" />
                            <x:Static Member="enums:EndCapStyle.Hidden" />
                        </ComboBox>

                        <TextBlock Text="Shooter Indicator" Style="{StaticResource LabelTextBlockStyle}" />
                        <ComboBox SelectedValue="{Binding SelectedShooterIndicatorStyle}" Style="{StaticResource StandardComboBoxStyle}">
                            <x:Static Member="enums:ShooterIndicatorStyle.Triangle" />
                            <x:Static Member="enums:ShooterIndicatorStyle.Glow" />
                            <x:Static Member="enums:ShooterIndicatorStyle.Both" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Player setup -->
                    <Grid Grid.Column="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="HOME" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />
                            <TextBlock Text="Saved Player" Style="{StaticResource LabelTextBlockStyle}" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding SavedPlayers}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedItem="{Binding HomePlayer.SavedPlayer, Mode=TwoWay}" />
                                <Button Grid.Column="1" Content="Delete"
                                        Style="{StaticResource InactiveButtonStyle}"
                                        Margin="8,0,0,0" Padding="10,4"
                                        ToolTip="Remove this saved player from the roster"
                                        Command="{Binding ForgetSavedPlayerCommand}"
                                        CommandParameter="{Binding HomePlayer.SavedPlayer}" />
                            </Grid>
                            <TextBlock Text="Team Name" Style="{StaticResource LabelTextBlockStyle}" />
                            <TextBox Text="{Binding HomePlayer.TeamName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBoxStyle}" />
                            <TextBlock Text="Player Name" Style="{StaticResource LabelTextBlockStyle}" />
                            <TextBox Text="{Binding HomePlayer.PlayerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBoxStyle}" />
                            <TextBlock Text="Race To" Style="{StaticResource LabelTextBlockStyle}" />
                            <TextBox Text="{Binding HomePlayer.RaceToTarget, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBoxStyle}" Width="70" HorizontalAlignment="Left" />

                            <TextBlock Text="End-Cap Icon" Style="{StaticResource LabelTextBlockStyle}" Margin="0,12,0,4" />
                            <Ellipse Width="32" Height="32" HorizontalAlignment="Left" Margin="0,0,0,6"
                                     Stroke="{StaticResource PanelBorderBrush}" StrokeThickness="1">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding HomePlayer.EndCapIconDataUri, Converter={StaticResource DataUriToImageSourceConverter}}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <WrapPanel>
                                <Button Content="Choose Icon..." Style="{StaticResource InactiveButtonStyle}" Command="{Binding PickHomeIconCommand}" Padding="10,4" Margin="0,0,8,8" />
                                <Button Content="Choose Flag..." Style="{StaticResource InactiveButtonStyle}" Command="{Binding PickHomeFlagCommand}" Padding="10,4" Margin="0,0,8,8" />
                                <Button Content="Clear" Style="{StaticResource InactiveButtonStyle}" Command="{Binding ClearHomeIconCommand}" Padding="10,4" Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="AWAY" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />
                            <TextBlock Text="Saved Player" Style="{StaticResource LabelTextBlockStyle}" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding SavedPlayers}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedItem="{Binding AwayPlayer.SavedPlayer, Mode=TwoWay}" />
                                <Button Grid.Column="1" Content="Delete"
                                        Style="{StaticResource InactiveButtonStyle}"
                                        Margin="8,0,0,0" Padding="10,4"
                                        ToolTip="Remove this saved player from the roster"
                                        Command="{Binding ForgetSavedPlayerCommand}"
                                        CommandParameter="{Binding AwayPlayer.SavedPlayer}" />
                            </Grid>
                            <TextBlock Text="Team Name" Style="{StaticResource LabelTextBlockStyle}" />
                            <TextBox Text="{Binding AwayPlayer.TeamName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBoxStyle}" />
                            <TextBlock Text="Player Name" Style="{StaticResource LabelTextBlockStyle}" />
                            <TextBox Text="{Binding AwayPlayer.PlayerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBoxStyle}" />
                            <TextBlock Text="Race To" Style="{StaticResource LabelTextBlockStyle}" />
                            <TextBox Text="{Binding AwayPlayer.RaceToTarget, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBoxStyle}" Width="70" HorizontalAlignment="Left"
                                     IsEnabled="{Binding IsSplitRaceTo}" />

                            <TextBlock Text="End-Cap Icon" Style="{StaticResource LabelTextBlockStyle}" Margin="0,12,0,4" />
                            <Ellipse Width="32" Height="32" HorizontalAlignment="Left" Margin="0,0,0,6"
                                     Stroke="{StaticResource PanelBorderBrush}" StrokeThickness="1">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding AwayPlayer.EndCapIconDataUri, Converter={StaticResource DataUriToImageSourceConverter}}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <WrapPanel>
                                <Button Content="Choose Icon..." Style="{StaticResource InactiveButtonStyle}" Command="{Binding PickAwayIconCommand}" Padding="10,4" Margin="0,0,8,8" />
                                <Button Content="Choose Flag..." Style="{StaticResource InactiveButtonStyle}" Command="{Binding PickAwayFlagCommand}" Padding="10,4" Margin="0,0,8,8" />
                                <Button Content="Clear" Style="{StaticResource InactiveButtonStyle}" Command="{Binding ClearAwayIconCommand}" Padding="10,4" Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
                </ScrollViewer>

                <!-- Overlay show/hide sits next to START MATCH so the operator can hide the score
                     bar and ball tracker first and start the match with them still hidden. -->
                <Grid Grid.Row="4" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentControl Grid.Column="0" VerticalAlignment="Center"
                                    Content="{Binding}" ContentTemplate="{StaticResource OverlayVisibilityTogglesTemplate}" />
                    <Button Grid.Column="1" Content="START MATCH" Style="{StaticResource ActiveButtonStyle}" Command="{Binding StartMatchCommand}" Padding="24,10" />
                </Grid>
            </Grid>

            <!-- ================= LIVE VIEW ================= -->
            <Grid Visibility="{Binding GameInitialized, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: winner banner + extension call + shooter toggle -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Winner banner and the shot-clock readout share the left of the header: one is only ever up
                         when the other has been cleared, so neither needs a row of its own. -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding WinnerAnnouncement}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,20,0" />
                        <TextBlock Text="SHOT CLOCK" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Visibility="{Binding ShotClockReadoutVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="{Binding ShotClockReadout}" Style="{StaticResource ValueTextBlockStyle}" VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="ShotClockReadout"
                                   Visibility="{Binding ShotClockReadoutVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <!-- Who still has their extension, beside the clock: the button that spends it is the next
                             thing to the right, and a spent one is silent. -->
                        <TextBlock Text="EXTENSIONS" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Margin="24,0,8,0" />
                        <TextBlock Text="{Binding HomeExtensionStatus}" VerticalAlignment="Center" Margin="0,0,14,0"
                                   AutomationProperties.AutomationId="HomeExtensionStatus">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ValueTextBlockStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HomeExtensionUsed}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding AwayExtensionStatus}" VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="AwayExtensionStatus">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ValueTextBlockStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AwayExtensionUsed}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <!-- Beside the shooter toggle because it is the same kind of thing: a mid-shot button the
                         operator presses for the player at the table. -->
                    <!-- Greyed once the shooter has spent theirs: the command's CanExecute is the rule, so this
                         only has to say what an unavailable button looks like, and the E key checks the same thing. -->
                    <Button Grid.Column="1" Content="CALL EXTENSION"
                            Command="{Binding ExtendShotClockCommand}" Height="36" Margin="0,0,8,0"
                            ToolTip="Adds the extension time to the running clock for the current shooter. One per player per rack.">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource InactiveButtonStyle}">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Setter Property="Cursor" Value="Arrow" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="2" Content="{Binding CurrentShooterButtonText}" Style="{StaticResource ActiveButtonStyle}" Command="{Binding ToggleCurrentShooterCommand}" Height="36" />
                </Grid>

                <!-- Player panels -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- HOME -->
                    <Border Grid.Column="0" Style="{StaticResource PlayerPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding HomePlayer.PlayerName}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                            <TextBlock Text="SCORE" Style="{StaticResource LabelTextBlockStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="−" Style="{StaticResource CounterButtonStyle}" Command="{Binding SubtractHomePointCommand}" Margin="0,0,4,0" />
                                <TextBlock Grid.Column="1" Text="{Binding HomeScore}" Style="{StaticResource LargeValueTextBlockStyle}" />
                                <Button Grid.Column="2" Content="+" Style="{StaticResource CounterButtonStyle}" Command="{Binding AddHomePointCommand}" Margin="4,0,0,0" />
                            </Grid>

                            <StackPanel Visibility="{Binding IsEightBall, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,16,0,0">
                                <TextBlock Text="Ball Group" Style="{StaticResource LabelTextBlockStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Solids" Style="{StaticResource InactiveButtonStyle}" Command="{Binding AssignHomeSolidsCommand}" />
                                    <Button Grid.Column="2" Content="Stripes" Style="{StaticResource InactiveButtonStyle}" Command="{Binding AssignHomeStripesCommand}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding HomeGroupBalls}" ItemTemplate="{StaticResource BallItemTemplate}" Margin="0,12,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- AWAY -->
                    <Border Grid.Column="2" Style="{StaticResource PlayerPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding AwayPlayer.PlayerName}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                            <TextBlock Text="SCORE" Style="{StaticResource LabelTextBlockStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="−" Style="{StaticResource CounterButtonStyle}" Command="{Binding SubtractAwayPointCommand}" Margin="0,0,4,0" />
                                <TextBlock Grid.Column="1" Text="{Binding AwayScore}" Style="{StaticResource LargeValueTextBlockStyle}" />
                                <Button Grid.Column="2" Content="+" Style="{StaticResource CounterButtonStyle}" Command="{Binding AddAwayPointCommand}" Margin="4,0,0,0" />
                            </Grid>

                            <StackPanel Visibility="{Binding IsEightBall, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,16,0,0">
                                <TextBlock Text="Ball Group" Style="{StaticResource LabelTextBlockStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Solids" Style="{StaticResource InactiveButtonStyle}" Command="{Binding AssignAwaySolidsCommand}" />
                                    <Button Grid.Column="2" Content="Stripes" Style="{StaticResource InactiveButtonStyle}" Command="{Binding AssignAwayStripesCommand}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding AwayGroupBalls}" ItemTemplate="{StaticResource BallItemTemplate}" Margin="0,12,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Shared ball display: 8-ball center / 9-10 ball numeric row -->
                <StackPanel Grid.Row="3" HorizontalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding EightBallItems}" ItemTemplate="{StaticResource BallItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding NumericRowBalls}" ItemTemplate="{StaticResource BallItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- Overlay element show/hide toggles (same panel as the setup screen's) -->
                <ContentControl Grid.Row="5" HorizontalAlignment="Left"
                                Content="{Binding}" ContentTemplate="{StaticResource OverlayVisibilityTogglesTemplate}" />

                <!-- New rack / reset match controls -->
                <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Filing a match is the operator's decision: a win on its own writes nothing, so this button
                         appears with the winner banner and goes again when the match is reset or a new one starts. -->
                    <TextBlock Text="Saved to history" Foreground="{StaticResource AccentBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,12,0"
                               Visibility="{Binding MatchSaved, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button Content="SAVE TO HISTORY" Style="{StaticResource InactiveButtonStyle}"
                            Command="{Binding SaveMatchCommand}" IsEnabled="{Binding CanSaveMatch}"
                            Visibility="{Binding MatchWon, Converter={StaticResource BoolToVisibilityConverter}}"
                            Padding="16,8" Margin="0,0,12,0"
                            ToolTip="Record this finished match in the match history." />
                    <Button Content="NEW RACK" Style="{StaticResource InactiveButtonStyle}" Command="{Binding NewRackCommand}" Padding="16,8" Margin="0,0,12,0" />
                    <Button Content="RESET MATCH" Style="{StaticResource InactiveButtonStyle}" Command="{Binding ResetMatchCommand}" Padding="16,8" />
                </StackPanel>
            </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
