<Window x:Class="PoolScoreboard.Controller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PoolScoreboard.Controller"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        xmlns:enums="clr-namespace:PoolScoreboard.Core.Enums;assembly=PoolScoreboard.Core"
        mc:Ignorable="d"
        Title="PoolScoreboard Controller"
        Height="780"
        Width="1200"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="BallItemTemplate">
            <Button Style="{StaticResource BallButtonStyle}"
                    Content="{Binding Number}"
                    Command="{Binding DataContext.TogglePocketedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" />
        </DataTemplate>
    </Window.Resources>
    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Persistent top bar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="POOLSCOREBOARD" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Help" Style="{StaticResource InactiveButtonStyle}"
                        Command="{Binding ShowHelpCommand}" Padding="16,6" />
            </Grid>

            <Grid Grid.Row="1">
            <!-- ================= MATCH SETUP ================= -->
            <Grid Visibility="{Binding GameInitialized, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="MATCH SETUP" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="1.3*" />
                    </Grid.ColumnDefinitions>

                    <!-- Game config + color theme -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Game" Style="{StaticResource LabelTextBlockStyle}" />
                        <ComboBox SelectedValue="{Binding SelectedGameType}" Style="{StaticResource StandardComboBoxStyle}">
                            <x:Static Member="enums:GameType.EightBall" />
                            <x:Static Member="enums:GameType.NineBall" />
                            <x:Static Member="enums:GameType.TenBall" />
                        </ComboBox>

                        <TextBlock Text="Race-To Mode" Style="{StaticResource LabelTextBlockStyle}" Margin="0,12,0,4" />
                        <ComboBox SelectedValue="{Binding SelectedRaceToMode}" Style="{StaticResource StandardComboBoxStyle}">
                            <x:Static Member="enums:RaceToMode.Single" />
                            <x:Static Member="enums:RaceToMode.Split" />
                        </ComboBox>

                        <TextBlock Text="COLOR THEME" Style="{StaticResource LabelTextBlockStyle}" Margin="0,20,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Home Background" VerticalAlignment="Center" Style="{StaticResource ValueTextBlockStyle}" />
                            <TextBox Grid.Column="2" Text="{Binding HomeBackgroundColor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBoxStyle}" Margin="0" />
                            <Button Grid.Column="4" Style="{StaticResource SwatchButtonStyle}"
                                    Background="{Binding HomeBackgroundColor, Converter={StaticResource HexColorToBrushConverter}}"
                                    Command="{Binding PickColorCommand}" CommandParameter="HomeBackground" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Away Background" VerticalAlignment="Center" Style="{StaticResource ValueTextBlockStyle}" />
                            <TextBox Grid.Column="2" Text="{Binding AwayBackgroundColor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBoxStyle}" Margin="0" />
                            <Button Grid.Column="4" Style="{StaticResource SwatchButtonStyle}"
                                    Background="{Binding AwayBackgroundColor, Converter={StaticResource HexColorToBrushConverter}}"
                                    Command="{Binding PickColorCommand}" CommandParameter="AwayBackground" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Home Accent" VerticalAlignment="Center" Style="{StaticResource ValueTextBlockStyle}" />
                            <TextBox Grid.Column="2" Text="{Binding HomeAccentColor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBoxStyle}" Margin="0" />
                            <Button Grid.Column="4" Style="{StaticResource SwatchButtonStyle}"
                                    Background="{Binding HomeAccentColor, Converter={StaticResource HexColorToBrushConverter}}"
                                    Command="{Binding PickColorCommand}" CommandParameter="HomeAccent" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Away Accent" VerticalAlignment="Center" Style="{StaticResource ValueTextBlockStyle}" />
                            <TextBox Grid.Column="2" Text="{Binding AwayAccentColor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBoxStyle}" Margin="0" />
                            <Button Grid.Column="4" Style="{StaticResource SwatchButtonStyle}"
                                    Background="{Binding AwayAccentColor, Converter={StaticResource HexColorToBrushConverter}}"
                                    Command="{Binding PickColorCommand}" CommandParameter="AwayAccent" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Text" VerticalAlignment="Center" Style="{StaticResource ValueTextBlockStyle}" />
                            <TextBox Grid.Column="2" Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBoxStyle}" Margin="0" />
                            <Button Grid.Column="4" Style="{StaticResource SwatchButtonStyle}"
                                    Background="{Binding TextColor, Converter={StaticResource HexColorToBrushConverter}}"
                                    Command="{Binding PickColorCommand}" CommandParameter="Text" />
                        </Grid>
                    </StackPanel>

                    <!-- Scoreboard style -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="SCOREBOARD STYLE" Style="{StaticResource LabelTextBlockStyle}" Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Roundness" VerticalAlignment="Center" Style="{StaticResource ValueTextBlockStyle}" />
                            <Slider Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding CornerRoundness}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding CornerRoundness}" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource ValueTextBlockStyle}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Scale" VerticalAlignment="Center" Style="{StaticResource ValueTextBlockStyle}" />
                            <Slider Grid.Column="2" Minimum="50" Maximum="200" Value="{Binding OverallScale}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding OverallScale, StringFormat={}{0}%}" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource ValueTextBlockStyle}" />
                        </Grid>

                        <CheckBox Content="Glossy Finish" IsChecked="{Binding GlossyFinish}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,12" />

                        <TextBlock Text="End-Cap Style" Style="{StaticResource LabelTextBlockStyle}" />
                        <ComboBox SelectedValue="{Binding SelectedEndCapStyle}" Style="{StaticResource StandardComboBoxStyle}" Margin="0,0,0,12">
                            <x:Static Member="enums:EndCapStyle.Dot" />
                            <x:Static Member="enums:EndCapStyle.Hidden" />
                        </ComboBox>

                        <TextBlock Text="Shooter Indicator" Style="{StaticResource LabelTextBlockStyle}" />
                        <ComboBox SelectedValue="{Binding SelectedShooterIndicatorStyle}" Style="{StaticResource StandardComboBoxStyle}">
                            <x:Static Member="enums:ShooterIndicatorStyle.Triangle" />
                            <x:Static Member="enums:ShooterIndicatorStyle.Glow" />
                            <x:Static Member="enums:ShooterIndicatorStyle.Both" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Player setup -->
                    <Grid Grid.Column="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="HOME" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />
                            <TextBlock Text="Team Name" Style="{StaticResource LabelTextBlockStyle}" />
                            <TextBox Text="{Binding HomePlayer.TeamName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBoxStyle}" />
                            <TextBlock Text="Player Name" Style="{StaticResource LabelTextBlockStyle}" />
                            <TextBox Text="{Binding HomePlayer.PlayerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBoxStyle}" />
                            <TextBlock Text="Race To" Style="{StaticResource LabelTextBlockStyle}" />
                            <TextBox Text="{Binding HomePlayer.RaceToTarget, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBoxStyle}" Width="70" HorizontalAlignment="Left" />

                            <TextBlock Text="End-Cap Icon" Style="{StaticResource LabelTextBlockStyle}" Margin="0,12,0,4" />
                            <Ellipse Width="32" Height="32" HorizontalAlignment="Left" Margin="0,0,0,6"
                                     Stroke="{StaticResource PanelBorderBrush}" StrokeThickness="1">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding HomePlayer.EndCapIconDataUri, Converter={StaticResource DataUriToImageSourceConverter}}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <WrapPanel>
                                <Button Content="Choose Icon..." Style="{StaticResource InactiveButtonStyle}" Command="{Binding PickHomeIconCommand}" Padding="10,4" Margin="0,0,8,8" />
                                <Button Content="Choose Flag..." Style="{StaticResource InactiveButtonStyle}" Command="{Binding PickHomeFlagCommand}" Padding="10,4" Margin="0,0,8,8" />
                                <Button Content="Clear" Style="{StaticResource InactiveButtonStyle}" Command="{Binding ClearHomeIconCommand}" Padding="10,4" Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="AWAY" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />
                            <TextBlock Text="Team Name" Style="{StaticResource LabelTextBlockStyle}" />
                            <TextBox Text="{Binding AwayPlayer.TeamName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBoxStyle}" />
                            <TextBlock Text="Player Name" Style="{StaticResource LabelTextBlockStyle}" />
                            <TextBox Text="{Binding AwayPlayer.PlayerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBoxStyle}" />
                            <TextBlock Text="Race To" Style="{StaticResource LabelTextBlockStyle}" />
                            <TextBox Text="{Binding AwayPlayer.RaceToTarget, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBoxStyle}" Width="70" HorizontalAlignment="Left"
                                     IsEnabled="{Binding IsSplitRaceTo}" />

                            <TextBlock Text="End-Cap Icon" Style="{StaticResource LabelTextBlockStyle}" Margin="0,12,0,4" />
                            <Ellipse Width="32" Height="32" HorizontalAlignment="Left" Margin="0,0,0,6"
                                     Stroke="{StaticResource PanelBorderBrush}" StrokeThickness="1">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding AwayPlayer.EndCapIconDataUri, Converter={StaticResource DataUriToImageSourceConverter}}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <WrapPanel>
                                <Button Content="Choose Icon..." Style="{StaticResource InactiveButtonStyle}" Command="{Binding PickAwayIconCommand}" Padding="10,4" Margin="0,0,8,8" />
                                <Button Content="Choose Flag..." Style="{StaticResource InactiveButtonStyle}" Command="{Binding PickAwayFlagCommand}" Padding="10,4" Margin="0,0,8,8" />
                                <Button Content="Clear" Style="{StaticResource InactiveButtonStyle}" Command="{Binding ClearAwayIconCommand}" Padding="10,4" Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
                </ScrollViewer>

                <Button Grid.Row="3" Content="START MATCH" Style="{StaticResource ActiveButtonStyle}" Command="{Binding StartMatchCommand}"
                        HorizontalAlignment="Right" Padding="24,10" Margin="0,16,0,0" />
            </Grid>

            <!-- ================= LIVE VIEW ================= -->
            <Grid Visibility="{Binding GameInitialized, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: winner banner + shooter toggle -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding WinnerAnnouncement}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" x:Name="CurrentShooterToggleButton" Style="{StaticResource ActiveButtonStyle}" Command="{Binding ToggleCurrentShooterCommand}" Height="36" />
                </Grid>

                <!-- Player panels -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- HOME -->
                    <Border Grid.Column="0" Style="{StaticResource PlayerPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding HomePlayer.PlayerName}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                            <TextBlock Text="SCORE" Style="{StaticResource LabelTextBlockStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="−" Style="{StaticResource CounterButtonStyle}" Command="{Binding UndoLastPointCommand}" Margin="0,0,4,0" />
                                <TextBlock Grid.Column="1" Text="{Binding HomeScore}" Style="{StaticResource LargeValueTextBlockStyle}" />
                                <Button Grid.Column="2" Content="+" Style="{StaticResource CounterButtonStyle}" Command="{Binding AddHomePointCommand}" Margin="4,0,0,0" />
                            </Grid>

                            <StackPanel Visibility="{Binding IsEightBall, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,16,0,0">
                                <TextBlock Text="Ball Group" Style="{StaticResource LabelTextBlockStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Solids" Style="{StaticResource InactiveButtonStyle}" Command="{Binding AssignHomeSolidsCommand}" />
                                    <Button Grid.Column="2" Content="Stripes" Style="{StaticResource InactiveButtonStyle}" Command="{Binding AssignHomeStripesCommand}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding HomeGroupBalls}" ItemTemplate="{StaticResource BallItemTemplate}" Margin="0,12,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- AWAY -->
                    <Border Grid.Column="2" Style="{StaticResource PlayerPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding AwayPlayer.PlayerName}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                            <TextBlock Text="SCORE" Style="{StaticResource LabelTextBlockStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="−" Style="{StaticResource CounterButtonStyle}" Command="{Binding UndoLastPointCommand}" Margin="0,0,4,0" />
                                <TextBlock Grid.Column="1" Text="{Binding AwayScore}" Style="{StaticResource LargeValueTextBlockStyle}" />
                                <Button Grid.Column="2" Content="+" Style="{StaticResource CounterButtonStyle}" Command="{Binding AddAwayPointCommand}" Margin="4,0,0,0" />
                            </Grid>

                            <StackPanel Visibility="{Binding IsEightBall, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,16,0,0">
                                <TextBlock Text="Ball Group" Style="{StaticResource LabelTextBlockStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Solids" Style="{StaticResource InactiveButtonStyle}" Command="{Binding AssignAwaySolidsCommand}" />
                                    <Button Grid.Column="2" Content="Stripes" Style="{StaticResource InactiveButtonStyle}" Command="{Binding AssignAwayStripesCommand}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding AwayGroupBalls}" ItemTemplate="{StaticResource BallItemTemplate}" Margin="0,12,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Shared ball display: 8-ball center / 9-10 ball numeric row -->
                <StackPanel Grid.Row="3" HorizontalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding EightBallItems}" ItemTemplate="{StaticResource BallItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding NumericRowBalls}" ItemTemplate="{StaticResource BallItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- Overlay element show/hide toggles -->
                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="OVERLAY" Style="{StaticResource LabelTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="Score Bar" Command="{Binding ToggleScoreBarVisibleCommand}"
                            Style="{Binding ScoreBarVisible, Converter={StaticResource BoolToButtonStyleConverter}}" Padding="12,8" Margin="0,0,8,0" />
                    <Button Content="Ball Tracker" Command="{Binding ToggleBallTrackerVisibleCommand}"
                            Style="{Binding BallTrackerVisible, Converter={StaticResource BoolToButtonStyleConverter}}" Padding="12,8" Margin="0,0,8,0" />
                    <Button Content="Winner Banner" Command="{Binding ToggleWinnerBannerVisibleCommand}"
                            Style="{Binding WinnerBannerVisible, Converter={StaticResource BoolToButtonStyleConverter}}" Padding="12,8" />
                </StackPanel>

                <!-- New rack / reset match controls -->
                <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="NEW RACK" Style="{StaticResource InactiveButtonStyle}" Command="{Binding NewRackCommand}" Padding="16,8" Margin="0,0,12,0" />
                    <Button Content="RESET MATCH" Style="{StaticResource InactiveButtonStyle}" Command="{Binding ResetMatchCommand}" Padding="16,8" />
                </StackPanel>
            </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
