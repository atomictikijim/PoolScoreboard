<Project>

  <!--
    Version policy lives in CLAUDE.md ("Versioning & Commit Policy"): 0.<major>.<ui> while
    pre-1.0 — major functionality bumps the middle number, UI-only changes bump the third.
    This is the one place the version is written; it is stamped onto every project so the
    published app and both libraries agree. Bump it in the commit that earns it.
  -->
  <PropertyGroup>
    <VersionPrefix>0.17.0</VersionPrefix>
  </PropertyGroup>

</Project>
