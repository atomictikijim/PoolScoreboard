#!/usr/bin/env bash
# Mirrors .github/workflows/ci.yml: the same Release build and the same Core test run.
#
# GitHub cannot reject a *direct push* on the result of a check that runs after that push, so a
# required status check only gates merges. This hook is what stops a red build from leaving this
# machine at all; the required `build-and-test` check still records the verdict on master.
#
# Enable once per clone:
#     git config core.hooksPath .githooks
#
# Bypass deliberately (e.g. a docs-only push while the build is broken):
#     git push --no-verify
set -uo pipefail

root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1

if ! command -v dotnet > /dev/null 2>&1; then
  echo "pre-push: dotnet not found on PATH - cannot verify the build, blocking the push." >&2
  echo "pre-push: install the .NET 8 SDK, or bypass with: git push --no-verify" >&2
  exit 1
fi

# tools/verify-live.ps1 cannot run here — it needs the real window and sockets — but a file that no longer
# parses would only fail the next time someone ran it by hand, which is exactly the rot this mirrors from CI.
ps="$(command -v pwsh || command -v powershell || true)"
if [ -n "$ps" ]; then
  echo "pre-push: parsing tools/verify-live.ps1 ..."
  if ! "$ps" -NoProfile -Command '$t=$null; $e=$null; [System.Management.Automation.Language.Parser]::ParseFile("tools/verify-live.ps1", [ref]$t, [ref]$e) | Out-Null; if ($e.Count -gt 0) { $e | ForEach-Object { Write-Error ("line {0}: {1}" -f $_.Extent.StartLineNumber, $_.Message) }; exit 1 }'; then
    echo "pre-push: tools/verify-live.ps1 does not parse - push blocked." >&2
    exit 1
  fi
else
  echo "pre-push: no PowerShell on PATH; skipping the live-check parse (CI checks it)."
fi

log="$(mktemp)"
trap 'rm -f "$log"' EXIT

echo "pre-push: building (Release) ..."
if ! dotnet build --configuration Release > "$log" 2>&1; then
  tail -n 30 "$log"
  echo "pre-push: BUILD FAILED - push blocked." >&2
  exit 1
fi

echo "pre-push: running tests ..."
if ! dotnet test PoolScoreboard.sln --configuration Release --no-build; then
  echo "pre-push: TESTS FAILED - push blocked." >&2
  exit 1
fi

echo "pre-push: build and tests passed."
exit 0
